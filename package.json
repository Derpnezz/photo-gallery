{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "npm run generate-metadata && next build",
    "start": "next start --port 3000 --hostname 0.0.0.0",
    "lint": "next lint",
    "generate-metadata": "tsc scripts/generate-metadata.ts --outDir scripts --module commonjs --outFile scripts/generate-metadata.cjs && node scripts/generate-metadata.cjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.15",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "typescript": "^5.8.2"
  }
}